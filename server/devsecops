#!/usr/bin/env bash
# =============================================================================
# devsecops · rocket code · comando de administracion del servidor DevSecOps OSS
#   devsecops add-repo      agrega un repositorio a escanear (cualquier git: GitHub,
#                           Azure Repos, GitLab, Bitbucket, CodeCommit, Gitea...)
#   devsecops list          muestra los repositorios configurados
#   devsecops remove-repo N quita un repositorio
#   devsecops apply         regenera la configuracion de Jenkins y lo reinicia
#   devsecops status        estado de los servicios y URLs
#   devsecops credentials   usuarios y contrasenas de administracion
#   devsecops set K V       ajusta FAIL_ON_HIGH (true/false) o ZAP_MODE (baseline/full)
#   devsecops update        actualiza imagenes (SonarQube, DefectDojo, Jenkins, Caddy)
#   devsecops logs [svc]    logs (caddy, sonarqube, jenkins, defectdojo)
# =============================================================================
set -uo pipefail
BASE=/opt/devsecops
ENVF="$BASE/.env"
REPOS="$BASE/repos.txt"

azul()  { printf '\033[1;34m%s\033[0m\n' "$*"; }
ok()    { printf '\033[1;32m  OK  \033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m  !!  \033[0m %s\n' "$*"; }
fail()  { printf '\033[1;31m  XX  \033[0m %s\n' "$*"; exit 1; }
ask()   { local v; read -r -p "  $1${2:+ [$2]}: " v; printf '%s' "${v:-${2:-}}"; }
secret(){ local v; read -r -s -p "  $1 (oculto): " v; echo >&2; printf '%s' "$v"; }
getenv(){ grep -s "^$1=" "$ENVF" | head -1 | cut -d= -f2-; }
setenv(){ touch "$ENVF"; chmod 600 "$ENVF"
  if grep -q "^$1=" "$ENVF"; then sed -i "s|^$1=.*|$1=$2|" "$ENVF"; else echo "$1=$2" >> "$ENVF"; fi; }
delenv(){ sed -i "/^$1=/d" "$ENVF"; }
key()   { printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_' | tr -cd 'A-Z0-9_'; }

[ "$(id -u)" = 0 ] || fail "Ejecuta con sudo: sudo devsecops $*"
[ -d "$BASE" ] || fail "No existe $BASE. Corre primero install.sh"
cd "$BASE" || exit 1

# ---------------------------------------------------------------- generadores
gen_secrets() {
  # Jenkins lee los secretos como archivos (/run/secrets), no como variables de entorno
  mkdir -p "$BASE/secrets"; chmod 700 "$BASE/secrets"
  rm -f "$BASE/secrets/"*
  local k v
  while IFS='=' read -r k v; do
    case "$k" in JENKINS_ADMIN_PASSWORD|SONAR_TOKEN|DOJO_API_KEY|GIT_*) printf '%s' "$v" > "$BASE/secrets/$k" ;; esac
  done < "$ENVF"
  chmod 600 "$BASE/secrets/"* 2>/dev/null || true
}

gen_casc() {
  local domain kit f="$BASE/jenkins/casc.yaml" name url br dast priv k
  domain="$(getenv DOMAIN)"; kit="$(getenv KIT_RAW)"
  cat > "$f" <<EOF
# generado por 'devsecops apply' · no editar a mano
jenkins:
  systemMessage: "rocket code · DevSecOps OSS"
  numExecutors: 2
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: admin
          password: "\${JENKINS_ADMIN_PASSWORD}"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false
  globalNodeProperties:
    - envVars:
        env:
          - key: SONAR_HOST_URL
            value: "http://sonarqube:9000"
          - key: DOJO_URL
            value: "http://defectdojo:8080"
          - key: DOCKER_NETWORK
            value: "devsecops"
          - key: KIT_RAW
            value: "$kit"
          - key: SONAR_BRANCHES
            value: "main"
          - key: FAIL_ON_HIGH
            value: "$(getenv FAIL_ON_HIGH || true)"
          - key: ZAP_MODE
            value: "$(getenv ZAP_MODE || true)"
unclassified:
  location:
    url: "https://ci.$domain/"
credentials:
  system:
    domainCredentials:
      - credentials:
          - string:
              scope: GLOBAL
              id: sonar-token
              secret: "\${SONAR_TOKEN}"
          - string:
              scope: GLOBAL
              id: dojo-api-key
              secret: "\${DOJO_API_KEY}"
EOF
  while IFS='|' read -r name url br dast priv; do
    [ -z "${name// }" ] && continue; case "$name" in \#*) continue ;; esac
    [ "${priv// }" = "si" ] || continue
    k="$(key "$name")"
    cat >> "$f" <<EOF
          - usernamePassword:
              scope: GLOBAL
              id: "git-$name"
              username: "\${GIT_${k}_USER}"
              password: "\${GIT_${k}_TOKEN}"
EOF
  done < "$REPOS"
  cat >> "$f" <<'EOF'
jobs:
  - file: /var/jenkins_home/devsecops/jobs.groovy
EOF
}

gen_jobs() {
  local f="$BASE/jenkins/jobs.groovy" name url br dast priv b brs cred
  echo "// generado por 'devsecops apply' · un job por repositorio" > "$f"
  while IFS='|' read -r name url br dast priv; do
    name="${name// }"; url="${url// }"
    [ -z "$name" ] || [ -z "$url" ] && continue; case "$name" in \#*) continue ;; esac
    [ -z "${br// }" ] && br="main develop"
    brs=""; for b in $br; do brs="$brs${brs:+, }[name: '*/$b']"; done
    cred=""; [ "${priv// }" = "si" ] && cred=", credentialsId: 'git-$name'"
    cat >> "$f" <<EOF
pipelineJob('scan-$name') {
  description('DevSecOps · $url · ramas: $br')
  logRotator { numToKeep(30) }
  definition {
    cps {
      sandbox(true)
      script('''
pipeline {
  agent any
  options { timeout(time: 120, unit: 'MINUTES'); disableConcurrentBuilds(); timestamps() }
  triggers { pollSCM('H/5 * * * *') }
  environment {
    APP_NAME = '$name'
    DAST_TARGET_URL = '${dast// }'
  }
  stages {
    stage('Checkout') {
      steps { checkout scmGit(branches: [$brs], userRemoteConfigs: [[url: '$url'$cred]]) }
    }
    stage('DevSecOps') {
      steps {
        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN'),
                         string(credentialsId: 'dojo-api-key', variable: 'DOJO_API_KEY')]) {
          sh 'export BRANCH="\${GIT_BRANCH#origin/}" COMMIT="\$GIT_COMMIT"; S="\${WORKSPACE}@tmp/devsecops-scan.sh"; mkdir -p "\${WORKSPACE}@tmp"; curl -fsSL "\$KIT_RAW/devsecops/devsecops-scan.sh" -o "\$S" && SRC_DIR="\$WORKSPACE" bash "\$S"'
        }
      }
    }
  }
  post { always { archiveArtifacts artifacts: 'devsecops-reports/**', allowEmptyArchive: true } }
}
''')
    }
  }
}
queue('scan-$name')

EOF
  done < "$REPOS"
}

jenkins_up() {
  for _ in $(seq 1 60); do
    docker compose exec -T jenkins curl -fsS -o /dev/null http://localhost:8080/login 2>/dev/null && return 0
    sleep 5
  done
  return 1
}

# ---------------------------------------------------------------- comandos
cmd_apply() {
  gen_secrets; gen_casc; gen_jobs
  ok "configuracion de Jenkins generada"
  docker compose build -q jenkins >/dev/null || fail "No se pudo construir la imagen de Jenkins"
  docker compose up -d --force-recreate jenkins >/dev/null 2>&1 || fail "Jenkins no arranco (devsecops logs jenkins)"
  printf '  esperando a Jenkins'
  if jenkins_up; then echo; ok "Jenkins listo: https://ci.$(getenv DOMAIN)"
  else echo; warn "Jenkins tarda en arrancar; revisa: sudo devsecops logs jenkins"; fi
}

cmd_add_repo() {
  azul "Agregar repositorio"
  echo "  Funciona con cualquier git por HTTPS: GitHub, Azure Repos, GitLab, Bitbucket, CodeCommit, Gitea."
  local name url br dast priv user tok k
  url=$(ask "URL HTTPS del repo (p. ej. https://github.com/org/app.git)")
  [ -n "$url" ] || fail "La URL es obligatoria"
  name=$(ask "Nombre corto" "$(basename "${url%.git}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')")
  name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"
  br=$(ask "Ramas a escanear (separadas por espacio)" "main develop")
  dast=$(ask "URL de staging para ZAP (vacio = sin DAST)")
  read -r -p "  ¿El repo es privado? [s/N]: " priv
  if [[ "$priv" =~ ^[sSyY] ]]; then
    priv=si; k="$(key "$name")"
    echo "  Usa un usuario y un token de SOLO LECTURA del repo."
    user=$(ask "Usuario git (en Azure Repos puede ser cualquier texto)")
    tok=$(secret "Token de solo lectura")
    [ -n "$tok" ] || fail "El token es obligatorio para repos privados"
    setenv "GIT_${k}_USER" "$user"; setenv "GIT_${k}_TOKEN" "$tok"
  else priv=no; fi
  sed -i "/^$name|/d" "$REPOS"
  echo "$name|$url|$br|$dast|$priv" >> "$REPOS"
  ok "repo '$name' agregado"
  cmd_apply
}

cmd_remove_repo() {
  local name="${1:-}" k
  [ -n "$name" ] || name=$(ask "Nombre del repo a quitar")
  grep -q "^$name|" "$REPOS" || fail "No existe '$name' (sudo devsecops list)"
  sed -i "/^$name|/d" "$REPOS"; k="$(key "$name")"; delenv "GIT_${k}_USER"; delenv "GIT_${k}_TOKEN"
  ok "repo '$name' quitado (borra el job 'scan-$name' en Jenkins si ya no lo quieres)"
  cmd_apply
}

cmd_list() {
  azul "Repositorios"
  printf '  %-20s %-50s %-18s %s\n' NOMBRE URL RAMAS STAGING
  grep -v '^#' "$REPOS" | while IFS='|' read -r n u b d _; do
    [ -n "$n" ] && printf '  %-20s %-50s %-18s %s\n' "$n" "$u" "$b" "${d:--}"; done
}

cmd_status() {
  local d; d="$(getenv DOMAIN)"
  azul "Servicios"
  docker compose ps --format '  {{.Service}}: {{.State}}' 2>/dev/null
  (cd "$BASE/defectdojo" && docker compose ps --format '  defectdojo-{{.Service}}: {{.State}}' 2>/dev/null)
  echo
  azul "URLs"
  echo "  SonarQube   https://sonar.$d"
  echo "  DefectDojo  https://dojo.$d"
  echo "  Jenkins     https://ci.$d"
  echo
  echo "  Usuarios y contrasenas:  sudo devsecops credentials"
  echo "  Agregar un repo:         sudo devsecops add-repo"
}

cmd_credentials() {
  local d; d="$(getenv DOMAIN)"
  azul "Credenciales de administracion (guardadas en $ENVF, solo root)"
  echo "  SonarQube   https://sonar.$d   admin / $(getenv SONAR_ADMIN_PASSWORD)"
  echo "  DefectDojo  https://dojo.$d    admin / $(getenv DOJO_ADMIN_PASSWORD)"
  echo "  Jenkins     https://ci.$d      admin / $(getenv JENKINS_ADMIN_PASSWORD)"
  echo
  warn "Crea usuarios individuales para cada dev en cada herramienta y no compartas estas."
}

cmd_set() {
  case "$1" in
    FAIL_ON_HIGH) [[ "$2" =~ ^(true|false)$ ]] || fail "FAIL_ON_HIGH acepta true o false" ;;
    ZAP_MODE)     [[ "$2" =~ ^(baseline|full)$ ]] || fail "ZAP_MODE acepta baseline o full" ;;
    *) fail "Uso: sudo devsecops set FAIL_ON_HIGH true|false   o   sudo devsecops set ZAP_MODE baseline|full" ;;
  esac
  setenv "$1" "$2"; ok "$1=$2"; cmd_apply
}

cmd_update() {
  azul "Actualizando"
  (cd "$BASE/defectdojo" && git pull -q && docker compose pull -q && docker compose up -d) >/dev/null 2>&1 && ok "DefectDojo"
  docker compose pull -q caddy sonar-db sonarqube >/dev/null 2>&1 && docker compose up -d caddy sonar-db sonarqube >/dev/null 2>&1 && ok "SonarQube y Caddy"
  docker compose build -q --pull jenkins >/dev/null 2>&1 && docker compose up -d jenkins >/dev/null 2>&1 && ok "Jenkins"
}

cmd_logs() {
  case "${1:-}" in
    defectdojo) cd "$BASE/defectdojo" && docker compose logs -f --tail 100 ;;
    "") docker compose logs -f --tail 100 ;;
    *) docker compose logs -f --tail 100 "$1" ;;
  esac
}

case "${1:-help}" in
  apply)        cmd_apply ;;
  add-repo)     cmd_add_repo ;;
  remove-repo)  cmd_remove_repo "${2:-}" ;;
  list)         cmd_list ;;
  status)       cmd_status ;;
  credentials)  cmd_credentials ;;
  set)          cmd_set "${2:-}" "${3:-}" ;;
  update)       cmd_update ;;
  logs)         cmd_logs "${2:-}" ;;
  *) sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
